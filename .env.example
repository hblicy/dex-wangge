# ═══════════════════════════════════════════════════════════
# 三交易所整合网格机器人 · 配置文件
# 复制本文件为 .env 并填入对应值
# ═══════════════════════════════════════════════════════════

# 服务端口（默认 8080）
PORT=8080

# 只监听本机；VPS 通过 SSH 隧道或 Tailscale Serve 访问
HOST=127.0.0.1

# 仪表盘 HTTP Basic Auth：用户名固定 admin；令牌至少 16 字符
# Linux 生成：openssl rand -hex 32
DASHBOARD_TOKEN=

# 允许的反向代理 HTTPS Origin，多个值用英文逗号分隔
# Tailscale 示例：https://your-vps.your-tailnet.ts.net
DASHBOARD_ORIGINS=

# 每个交易所流及总览流允许的最大 SSE 连接数（1-100）
MAX_SSE_CLIENTS=10

# 模拟账户初始余额 USDC（paper 模式共用）
PAPER_BALANCE=10000

# ── 代理 / IP 配置 ────────────────────────────────────────
# 全局代理：同时应用于所有三个交易所（优先级最高）
# 留空则各交易所使用各自的独立代理配置
# 支持格式：
#   HTTP(S):  http://127.0.0.1:7890
#   SOCKS5:   socks5://127.0.0.1:1080
#   带认证:   socks5://user:pass@host:port
#   简写格式: host:port:user:pass
GLOBAL_PROXY=

# 各交易所独立代理（仅在 GLOBAL_PROXY 未设置时生效）
DECIBEL_PROXY=
EXTENDED_PROXY=
RISEX_PROXY=

# ── Decibel 交易所 ────────────────────────────────────────
# 运行模式：paper（模拟）| live（实盘）
DE_MODE=paper
# 网络：mainnet | testnet
DE_NETWORK=mainnet

# 实盘凭据（DE_MODE=live 时必填）
# API Key：在 geomi.dev 创建
DECIBEL_API_KEY=
# API 钱包 Ed25519 私钥：在 app.decibel.trade/api 创建
DECIBEL_PRIVATE_KEY=
# Trading Account 地址
DECIBEL_SUBACCOUNT=
# 自定义 API URL（留空使用默认）
DECIBEL_API_URL=

# ── Extended 交易所 ───────────────────────────────────────
EX_MODE=paper
EX_NETWORK=mainnet

# 实盘凭据（EX_MODE=live 时必填）
# 在 app.extended.exchange → API Management 获取
EXTENDED_API_KEY=
EXTENDED_VAULT=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_MAX_FEE=0.0005
EXTENDED_API_URL=

# ── RISEx 交易所 ──────────────────────────────────────────
# RISEx 仅支持 mainnet 实盘；实盘只开放 BTC-PERP / ETH-PERP
RS_MODE=paper
RS_NETWORK=mainnet

# RS_MODE=live 时必填：独立 RISEx 账户与已注册 session signer
RISEX_ACCOUNT=
RISEX_SIGNER_KEY=

# live 模式必须保持官方地址，不支持自定义代理域名
RISEX_API_URL=https://api.rise.trade
RISEX_WS_URL=wss://api.rise.trade/ws/

# ── AI 助手（可选：风控哨兵/日报/市况分析/对话操控/出区间建议）──
# 协议类型：openai | anthropic | gemini
#   openai = 所有 OpenAI 兼容服务（OpenAI/DeepSeek/Kimi/通义/智谱/OpenRouter/Ollama 等）
AI_PROVIDER=openai
AI_API_KEY=
# 接口地址（留空用官方默认）。示例：
#   DeepSeek: https://api.deepseek.com/v1    Kimi: https://api.moonshot.cn/v1
#   通义: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama 本地: http://127.0.0.1:11434/v1
AI_BASE_URL=
# 主模型（复盘/分析/对话）与小模型（哨兵巡检，高频省钱，可留空同主模型）
AI_MODEL=
AI_MODEL_SMALL=
# 哨兵巡检间隔（分钟，0=关闭）；BTC 市况报告间隔（分钟，0=关闭）；日报生成时间（0-23 整点）
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

# 通知推送（可选，配了才会推）：Telegram 机器人 + 通用 Webhook（POST {"text":...}）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=
